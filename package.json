{
  "name": "editeur-luxe",
  "version": "0.1.0",
  "description": "Luxe - interactive review and visual artifact tooling for agents",
  "type": "module",
  "bin": {
    "luxe": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills/luxe",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "check": "npm run build && npm run lint && npm run format:check && npm run typecheck && npm test && npm run naming",
    "lint": "eslint bin src test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "naming": "node scripts/check-naming.js",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snitilf/Luxe.git"
  },
  "keywords": [
    "luxe",
    "skill",
    "cli"
  ],
  "author": "snitilf",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/snitilf/Luxe/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  }
}
